{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "linkWithRole": {
      "$ref": "https://opengeospatial.github.io/bblocks/annotated-schemas/geo/json-fg/link-role/schema.json"
    },
    "codeRef": {
      "$ref": "https://opengeospatial.github.io/bblocks/annotated-schemas/ogc-utils/iri-or-curie/schema.json"
    },
    "Options": {
      "anyOf": [
        {
          "$ref": "#/$defs/linkWithRole"
        },
        {
          "properties": {
            "role": {
              "$ref": "#/$defs/codeRef"
            },
            "description": {
              "type": "string",
              "x-jsonld-id": "http://purl.org/dc/terms/description"
            }
          },
          "required": [
            "description"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "AnnotationSet": {
      "anyOf": [
        {
          "$ref": "#/$defs/Options"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Options"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/AnnotationSet"
    }
  ],
  "x-jsonld-extra-terms": {
    "description": "http://purl.org/dc/terms/description"
  },
  "x-jsonld-prefixes": {
    "dct": "http://purl.org/dc/terms/"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "icsm.csdm.datatypes.annotation",
    "register": "https://surroundaustralia.github.io/3d-csdm-common/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-10-27"
  }
}