{
  "@context": {
    "csd": "https://linked.data.gov.au/def/csdm/csd/",
    "sdo": "https://schema.org/" ,
    "surv": "https://linked.data.gov.au/def/csdm/surveyfeatures/",
    "container": "https://linked.data.gov.au/def/csdm/container/",
    "parcel": "https://w3id.org/ogc/ladm/parcels/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "topo": "https://purl.org/geojson/topo#",
    "featureType": "@type",
    "CSD": {
      "@id": "container:CSD"
    },
    "name": "rdfs:label",
    "address": "sdo:address",
    "surveyDescription": "container:surveyDescription",
    "surveyDescriptors": "container:surveyDescriptors",
    "bearingRotation": "container:bearingRotation",
    "points": {
      "@id": "container:points",
      "@context": {
        "featureType": "https://purl.org/geojson/vocab#collectionFeatureType",
        "features": {
          "@id": "https://purl.org/geojson/vocab#features",
          "@context": {
            "featureType": "@type"
          }
        }
      }
    },
    "parcels": {
      "@id": "container:parcels",
      "@context": {
        "featureType": "https://purl.org/geojson/vocab#collectionFeatureType",
        "features": {
          "@id": "https://purl.org/geojson/vocab#features",
          "@context": {
            "featureType": "@type"
          }
        }
      }
    },
    "annotations": {
      "@id": "container:annotations"
    },
    "vectorObservations": {
      "@id": "container:vectorObservations"
    },
    "adoptedObservations": {
      "@id": "container:adoptedObservations"
    },
    "occupationObservations": {
      "@id": "container:occupationObservations"
    },
    "occupationFeatures": {
      "@id": "container:occupationFeatures"
    },
    "locality": {
      "@id": "csd:locality"
    },
    "edges": {
      "@id": "topo:edges",
      "@context": {
        "featureType": "https://purl.org/geojson/vocab#collectionFeatureType",
        "features": {
          "@id": "https://purl.org/geojson/vocab#features",
          "@context": {
            "featureType": "@type"
          }
        }
      }
    },
    "observedVectors": {
      "@id": "container:observedVectors",
      "@context": {
        "featureType": "https://purl.org/geojson/vocab#collectionFeatureType",
        "features": {
          "@id": "https://purl.org/geojson/vocab#features",
          "@context": {
            "featureType": "@type"
          }
        }
      }
    },
    "adoptedVectors": {
      "@id": "container:adoptedVectors",
      "@context": {
        "featureType": "https://purl.org/geojson/vocab#collectionFeatureType",
        "features": {
          "@id": "https://purl.org/geojson/vocab#features",
          "@context": {
            "featureType": "@type"
          }
        }
      }
    },
    "purpose": {
      "@id": "container:purpose",
      "@type": "@id"
    },
    "horizontalCRS": {
      "@id": "container:horizontalCRS",
      "@type": "@id"
    },
    "compoundCRS": {
      "@id": "container:compoundCRS",
      "@type": "@id"
    },
    "verticalDatum": {
      "@id": "container:verticalDatum",
      "@type": "@id"
    },
    "surveyType": {
      "@id": "container:surveyType",
      "@type": "@id"
    },
    "SubtendedAngle": "surv:SubtendedAngle",
    "PrimaryParcel": {
      "@id": "parcel:PrimaryParcel",
      "@type": "@id"
    },
    "SecondaryParcel": {
      "@id": "parcel:SecondaryParcel",
      "@type": "@id"
    },
    "referencedCSDs": {
      "@id": "container:referencedCSD"
    },
    "adminUnit": {
      "@type": "@id",
      "@id": "container:adminUnit",
      "@container": "@set"
    },
    "supportingDocuments": {
      "@id": "container:supportingDocuments",
      "@container": "@set"
    }
  }
}